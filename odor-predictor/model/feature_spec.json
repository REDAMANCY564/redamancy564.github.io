{
  "max_atoms": 64,
  "num_features": 26,
  "atom_features": [
    {
      "name": "element",
      "values": [
        "C",
        "N",
        "O",
        "S",
        "F",
        "Cl",
        "Br",
        "I",
        "P"
      ],
      "other_bucket": true
    },
    {
      "name": "heavy_degree",
      "values": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "clip": "above max -> max"
    },
    {
      "name": "total_num_hs",
      "values": [
        0,
        1,
        2,
        3,
        4
      ],
      "clip": "above max -> max"
    },
    {
      "name": "formal_charge",
      "values": [
        -1,
        0,
        1
      ],
      "other_value_maps_to": 0
    },
    {
      "name": "is_aromatic",
      "binary": true
    },
    {
      "name": "is_in_ring",
      "binary": true
    }
  ],
  "mask": "1 for real atoms, 0 for padding",
  "atom_order": "RDKit atom index of the parsed (non-stereo) SMILES, hydrogens implicit",
  "model_inputs": {
    "X": "[B, 64, F] float32",
    "E": "[B, 64, 64, 6] float32",
    "mask": "[B, 64] float32"
  },
  "model_type": "mpnn",
  "num_bond_features": 6,
  "bond_features": [
    {
      "name": "bond_type",
      "values": [
        "single",
        "double",
        "triple",
        "aromatic"
      ],
      "other_bucket": true,
      "note": "aromatic bonds (RDKit AROMATIC) count as aromatic, not by Kekule order"
    },
    {
      "name": "is_in_ring",
      "binary": true
    }
  ],
  "bond_tensor": "E[i, j] = E[j, i] = bond features of the bond i-j; all zero where i and j are not bonded (no self loops); padded rows/cols 0. The model uses E.sum(-1) > 0 as adjacency",
  "model_file": "odor_mpnn.onnx",
  "onnx_opset": 17,
  "num_labels": 138,
  "model_output": {
    "name": "probs",
    "shape": "[B, num_labels]",
    "sigmoid_applied": true,
    "label_order": "same as labels.json"
  },
  "model_config": {
    "num_layers": 3,
    "hidden": 256,
    "update": "res",
    "dropout": 0.2,
    "seed": 2
  }
}